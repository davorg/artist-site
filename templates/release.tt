<article>
  <header class="release-hero">
    <img
      class="artwork"
      src="[% page.artwork_url | html %]"
      alt="[% page.artwork.alt | html %]"
      width="[% page.artwork.width %]"
      height="[% page.artwork.height %]"
    >

    <div>
      <p class="eyebrow">
        [% page.type_label | html %] · [% page.release_date_label | html %]
      </p>
      <h1>[% page.title | html %]</h1>
      <p class="intro">[% page.tagline | html %]</p>
      <p>[% page.description | html %]</p>

      [% IF page.spotify_embed_url %]
        <iframe
          class="player"
          src="[% page.spotify_embed_url | html %]"
          title="Listen to [% page.title | html %] on Spotify"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        ></iframe>
      [% END %]

      [% FOREACH link IN page.links.items %]
        <a class="button" href="[% link.url | html %]">
          Listen on [% link.name | html %]
        </a>
      [% END %]
    </div>
  </header>

  [% IF page.has_multiple_tracks %]
    <section class="track-listing">
      <p class="eyebrow">Track listing</p>
      <h2>Tracks</h2>

      <ol>
        [% FOREACH track IN page.tracks %]
          <li
            value="[% track.position %]"
            [% IF track.is_unannounced %]
              class="track track--unannounced"
              aria-label="Track [% track.position %], title not yet announced"
            [% ELSE %]
              class="track"
            [% END %]
          >[% IF track.is_unannounced %]
              [% track.display_title | html %]
            [% ELSE %]
              <a href="[% track.song.url | html %]">
                [% track.display_title | html %]
              </a>
            [% END %]</li>
        [% END %]
      </ol>
    </section>
  [% END %]

  [% IF NOT page.has_multiple_tracks %]
    <section class="release-song-link">
      <p class="eyebrow">The song</p>
      <h2>[% page.primary_track.song.title | html %]</h2>
      <a class="text-link" href="[% page.primary_track.song.url | html %]">
        Read the lyrics and story →
      </a>
    </section>
  [% END %]
</article>
