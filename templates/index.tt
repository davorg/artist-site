<section class="hero">
  <div class="hero__content">
    <p class="eyebrow">
      Independent music from [% artist.location | html %]
    </p>

    <h1>[% artist.tagline | html %]</h1>
    <p class="intro">[% artist.description | html %]</p>

    <div class="hero__actions">
      <a class="button" href="#music">Enter the music</a>

      [% PROCESS 'social-links.tt'
          social_links_label = artist.social_links_label
          social_links_class = 'social-links--hero'
      %]
    </div>
  </div>

  [% IF artist.hero_image_url %]
    <img
      class="hero__image"
      src="[% artist.hero_image_url | html %]"
      alt="[% artist.hero_image_alt | html %]"
      width="[% artist.hero_image_width %]"
      height="[% artist.hero_image_height %]"
    >
  [% END %]
</section>

<section class="releases" id="music">
  <p class="eyebrow">Latest chapter</p>
  <h2>Music</h2>

  [% PROCESS 'release-card.tt' release = featured_release %]

  <p class="catalogue-link">
    <a class="text-link" href="/release/">See all releases →</a>
  </p>
</section>

<section class="about" id="about">
  <p class="eyebrow">[% artist.name | html %]</p>
  <h2>[% artist.about_title | html %]</h2>
  <p>[% artist.description | html %]</p>
</section>
